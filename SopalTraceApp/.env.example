# =============================================================================
# CONFIGURATION SOPALTRACE — modèle à copier en ".env" (jamais versionné)
# Toutes les valeurs ci-dessous sont des exemples : les remplacer par des secrets forts.
# =============================================================================

# 1. Base de données (mot de passe SQL Server : 12 caractères min., complexe)
DB_PASSWORD=ChangerCeMotDePasse!2026

# 2. Authentification JWT (32 caractères minimum, aléatoire ; l'API refuse de démarrer sinon)
Jwt__Secret=GenererUneCleAleatoireDe32CaracteresMinimum

# 3. Origines autorisées à appeler l'API (inutile si le front est servi par le même nginx)
# Cors__AllowedOrigins__0=https://sopaltrace.exemple.tn

# 4. Adresse du front, utilisée dans les liens envoyés par e-mail (activation du compte)
Auth__FrontendBaseUrl=https://sopaltrace.exemple.tn
# Verrouillage après échecs de connexion et limite des requêtes d'authentification par IP (valeurs par défaut)
# Auth__MaxFailedLogins=5
# Auth__LockoutMinutes=15
# Auth__RequetesParMinute=10

# 5. Email (SMTP)
SMTP_SERVER=smtp.exemple.tn
SMTP_PORT=587
SMTP_USERNAME=
EMAIL_SENDER=
EMAIL_PASSWORD=
