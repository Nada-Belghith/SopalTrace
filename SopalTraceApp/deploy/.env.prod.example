# =============================================================================
# SopalTrace — configuration du serveur (copier en « .env » à côté de docker-compose.prod.yml)
# Modèle sans secret (versionné) : remplacer toutes les valeurs par des secrets forts dans « .env », qui ne doit jamais être versionné.
# =============================================================================

# Version à déployer (tag d'image publié par la CI : v1.2.0, ou « latest » pour la dernière version de main)
SOPALTRACE_VERSION=latest
# Registre des images (privé : « docker login ghcr.io » avec un jeton en lecture des paquets)
SOPALTRACE_REGISTRY=ghcr.io/nada-belghith
# Port HTTP exposé par le serveur
SOPALTRACE_HTTP_PORT=80
# Dossier des sauvegardes SQL sur le serveur (à copier aussi hors du serveur)
SOPALTRACE_BACKUP_DIR=./sauvegardes

# SQL Server : Express (gratuit, ≤ 10 Go) ou Standard selon la licence
MSSQL_PID=Express
DB_PASSWORD=ChangerCeMotDePasse!2026
# Compte applicatif à droits limités (recommandé) ; à défaut l'API utilise « sa »
# DB_USER=sopaltrace_app
# DB_APP_PASSWORD=

# Première installation : scripts exécutés par « init-db » (production : 01 et 02 seulement)
INIT_SCRIPTS=01_Create_SopalTraceDB.sql 02_ReferenceData_SopalTraceDB.sql

# Authentification
Jwt__Secret=GenererUneCleAleatoireDe32CaracteresMinimum
Auth__FrontendBaseUrl=https://sopaltrace.exemple.tn

# E-mail (SMTP)
SMTP_SERVER=smtp.exemple.tn
SMTP_PORT=587
SMTP_USERNAME=
EMAIL_SENDER=
EMAIL_PASSWORD=
